// The installer's resources: the port's icon, the manifest (Windows 10/11 style, per-monitor DPI, no administrator rights)
// and the version (INSTALLER_VERSION_NUM, from runtime/app_name.h through the Makefile).
#include <winver.h>
#ifndef INSTALLER_VERSION_NUM
#define INSTALLER_VERSION_NUM 0,0,0,0
#endif
#ifndef INSTALLER_VERSION_STR
#define INSTALLER_VERSION_STR "0.0.0"
#endif

1 ICON "icon.ico"
1 24 "installer.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION INSTALLER_VERSION_NUM
PRODUCTVERSION INSTALLER_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "smrpg-recomp"
            VALUE "FileDescription", "SMRPG Recomp installer"
            VALUE "FileVersion", INSTALLER_VERSION_STR
            VALUE "ProductName", "SMRPG Recomp"
            VALUE "ProductVersion", INSTALLER_VERSION_STR
            VALUE "OriginalFilename", "SMRPG-Recomp-Installer.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
